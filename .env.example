# ===========================================
# NirmanConnect Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env to git
# ===========================================

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_SECRET_KEY=change-this-to-another-long-random-string

# Database (PostgreSQL)
DATABASE_URL=postgresql://nirman:nirmanpass@db:5432/nirmanconnect
# Local alternative: postgresql://nirman:nirmanpass@localhost:5432/nirmanconnect

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# File uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,pdf

# Azure Blob Storage (optional – falls back to local storage in dev)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=nirmanconnect

# Rate limiting
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URL=memory://

# Admin seed (only used by seed script)
ADMIN_EMAIL=admin@nirmanconnect.com
ADMIN_PASSWORD=Admin@12345
